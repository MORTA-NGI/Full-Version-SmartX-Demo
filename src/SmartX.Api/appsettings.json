{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ActivePillars": 3,
    "MaxPacketsPerTick": 300,
    "TickMilliseconds": 100,
    "StaleAfterSeconds": 5,
    "OfflineAfterSeconds": 12,
    "SeedHistoryHours": 48,
    "SeedIntervalSeconds": 60,
    "MaxHistoryPerDevice": 150000
  },
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileBytes": 15728640,
    "EncryptionKeyBase64": ""
  }
}

@* Anomaly Radar: rows = devices, columns = 10-second buckets, colour = |z-score|, grey gap = no packets (dropout). *@
@inject NavigationManager Nav

@if (Radar is null)
{
    <div class="chart-empty" style="height:280px">Loading radar…</div>
}
else
{
    <div class="radar" style="--cols:@Radar.ColumnLabels.Count">
        <div class="radar-head">
            <span></span>
            @for (int c = 0; c < Radar.ColumnLabels.Count; c++)
            {
                <span class="radar-col">@(c % 3 == 0 ? Radar.ColumnLabels[c] : "")</span>
            }
            <span class="radar-col">now</span>
        </div>
        @for (int r = 0; r < Radar.RowLabels.Count; r++)
        {
            var hb = r < Radar.Heartbeats.Count ? Radar.Heartbeats[r] : null;
            var row = Radar.Cells[r];
            <div class="radar-row @(hb?.Status == DeviceStatus.Offline ? "offline" : "")" @key="Radar.RowLabels[r]">
                <button class="radar-label" title="@hb?.Zone" @onclick="() => Open(hb?.Mac)">
                    <span class="pulse @(hb?.Status.ToString().ToLowerInvariant())"></span>@Radar.RowLabels[r]
                </button>
                @for (int c = 0; c < row.Length; c++)
                {
                    var v = row[c];
                    <span class="cell @Level(v)" title="@Tip(Radar.RowLabels[r], Radar.ColumnLabels[c], v)"></span>
                }
                <span class="radar-last @(hb?.Severity.ToString().ToLowerInvariant())">@(hb?.LastDisplay)</span>
            </div>
        }
    </div>
    <div class="legend">
        <span><i class="cell gap"></i>No packets (dropout)</span>
        <span><i class="cell l0"></i>Normal</span>
        <span><i class="cell l1"></i>Unusual (|z| ≥ 2)</span>
        <span><i class="cell l2"></i>Suspicious (|z| ≥ 3)</span>
        <span><i class="cell l3"></i>Spike (|z| ≥ 4)</span>
    </div>
}

@code {
    [Parameter] public RadarDto? Radar { get; set; }

    private static string Level(double? z) => z switch
    {
        null => "gap",
        >= 4.0 => "l3",
        >= 3.0 => "l2",
        >= 2.0 => "l1",
        _ => "l0"
    };

    private static string Tip(string device, string bucket, double? z) =>
        z is null ? $"{device} · {bucket}: no packets received" : $"{device} · {bucket}: |z| = {z:0.0}";

    private void Open(string? mac)
    {
        if (mac is not null) Nav.NavigateTo($"/ingestion/device/{Uri.EscapeDataString(mac)}");
    }
}

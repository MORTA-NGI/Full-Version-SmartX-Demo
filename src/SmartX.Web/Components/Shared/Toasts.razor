@implements IDisposable
@inject ToastService Service

<div class="toasts" role="status" aria-live="polite">
    @foreach (var t in Service.Items)
    {
        <div class="toast @t.Level.ToString().ToLowerInvariant()" @key="t.Id">
            <span class="toast-ico">@(t.Level switch { ToastLevel.Success => "✓", ToastLevel.Warning => "!", ToastLevel.Error => "✕", _ => "i" })</span>
            <span class="toast-msg">@t.Message</span>
            <button class="toast-x" aria-label="Dismiss" @onclick="() => Service.Dismiss(t.Id)">×</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Service.Changed -= OnChanged;
}

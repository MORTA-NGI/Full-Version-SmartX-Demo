@inherits LiveComponentBase
@implements IDisposable
@inject NavigationManager Nav

<aside class="sidenav @(_open ? "open" : "")">
    <div class="brand">
        <a href="/" class="brand-link" @onclick="Close">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="5" /><circle cx="6" cy="8" r="2.4" class="sat" /><circle cx="26" cy="8" r="2.4" class="sat" /><circle cx="16" cy="27" r="2.4" class="sat" /><path d="M8 9.5 13 14M24 9.5 19 14M16 21v3.6" /></svg>
            </span>
            <span>
                <strong>Smart-X</strong>
                <small>IoT Mesh Gateway</small>
            </span>
        </a>
        <button class="nav-toggle" aria-label="Toggle navigation" @onclick="() => _open = !_open">☰</button>
    </div>

    <nav class="nav-links" @onclick="Close">
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-item"><span class="ico">⌂</span><span>Gateway home</span></NavLink>
        @foreach (var p in _pillars)
        {
            if (p.Enabled)
            {
                <NavLink href="@p.Route" class="nav-item"><span class="ico">@p.Icon</span><span>@p.Title<small>@p.Part</small></span></NavLink>
            }
            else
            {
                <span class="nav-item disabled" title="Unlocks in @p.Part"><span class="ico">🔒</span><span>@p.Title<small>Disabled · @p.Part</small></span></span>
            }
        }
    </nav>

    <div class="nav-status">
        @if (_status is null)
        {
            <div class="pill @(ApiOnline ? "muted" : "bad")">@(ApiOnline ? "Connecting…" : "API offline")</div>
        }
        else
        {
            <div class="pill @(ApiOnline ? "ok" : "bad")"><span class="dot"></span>@(ApiOnline ? "API connected" : "API offline")</div>
            <dl class="mini-stats">
                <div><dt>Online</dt><dd>@_status.Online<span>/@_status.DeviceCount</span></dd></div>
                <div><dt>Queued</dt><dd>@(_status.FifoDepth + _status.PriorityDepth)</dd></div>
                <div><dt>Processed</dt><dd>@_status.PacketsProcessed.ToString("N0")</dd></div>
            </dl>
            <p class="clock">SAST @TimeFormat.Clock(_status.ServerTimeUtc)</p>
        }
    </div>
</aside>

@code {
    private GatewayStatusDto? _status;
    private IReadOnlyList<PillarDto> _pillars = DefaultPillars;
    private bool _open;

    private static readonly IReadOnlyList<PillarDto> DefaultPillars =
    [
        new("ingestion", "Sensor Ingestion & Telemetry", "", "/ingestion", true, "Part 1", "📡"),
        new("stream", "Real-Time Command Stream", "", "/stream", true, "Part 2", "⚡"),
        new("topology", "Network Topology & Routing", "", "/topology", true, "PoE", "🕸️"),
    ];

    protected override TimeSpan RefreshInterval => TimeSpan.FromSeconds(3);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task RefreshAsync(CancellationToken ct)
    {
        _status = await Api.GetStatusAsync(ct);
        if (_status is not null) _pillars = _status.Pillars;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Ui.Navigations++;

    private void Close() => _open = false;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
